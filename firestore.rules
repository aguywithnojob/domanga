rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write only their own profile.
    // Exception: any authenticated user may update another user's coupleId/partnerId
    // fields only — needed when Person B joins Person A's couple.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId', 'partnerId'])
      );
    }

    // Couples: any authenticated user may read (needed for invite code lookup).
    // Create: any authenticated user (they become the first member).
    // Update: existing members OR joining a couple that still only has 1 member.
    match /couples/{coupleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        resource.data.members.size() < 2
      );
    }

    // Expenses: only couple members can read/write/delete
    match /expenses/{expenseId} {
      // Allow create if user is authenticated (coupleId checked in app)
      allow create: if request.auth != null;

      // Read/delete only for couple members
      allow read, delete: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.coupleId)).data.members;

      // Only the person who created the expense can update it
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.paidBy;
    }

    // OTP rate limiting — phone number stored as doc ID.
    // Allow unauthenticated read (to check limit before sending) and
    // unauthenticated write (to record a send). Firebase Auth itself
    // gates actual OTP delivery, so spoofed writes only hurt the writer.
    match /otpLimits/{phone} {
      allow read, write: if true;
    }

    // App config — feature flags and category overrides.
    // Any authenticated user can read. Only authenticated users can write
    // (admin gate is enforced at the app level via the /admin route).
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
